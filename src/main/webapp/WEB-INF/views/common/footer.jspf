<%@ page pageEncoding="UTF-8" %>
<app-footer><footer class="site-footer"><div class="container footer-top"><div><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark"><ui:icon name="leaf"/></span><span><c:out value="${config.shortName}"/><small><c:out value="${info.hindi}"/></small></span></a><p><c:out value="${config.tagline}"/></p></div><div class="footer-links"><a href="${pageContext.request.contextPath}/#about">Our village</a><a href="${pageContext.request.contextPath}/gallery">Gallery &amp; films</a><a href="${pageContext.request.contextPath}/blog">Village journal</a><a href="${pageContext.request.contextPath}/submit-blog">Share a story</a><a href="${pageContext.request.contextPath}/#contact">Get in touch</a><c:forEach items="${config.socialLinks}" var="social"><c:if test="${not empty social.value}"><a href="${fn:escapeXml(social.value)}" target="_blank" rel="noopener noreferrer"><c:out value="${social.key}"/> ↗</a></c:if></c:forEach></div></div><div class="container footer-bottom"><span>© ${year} <c:out value="${config.siteName}"/>. <c:out value="${info.footer}"/></span><a href="${pageContext.request.contextPath}/admin">Content workspace <span aria-hidden="true">↗</span></a></div></footer></app-footer>