<%@ page pageEncoding="UTF-8" %>
<app-navbar><header class="navbar"><div class="nav-inner"><a class="brand" href="${pageContext.request.contextPath}/" aria-label="Gautiyan Tola home"><span class="brand-mark"><ui:icon name="leaf"/></span><span><c:out value="${config.shortName}"/><small>SAMAN · OUR VILLAGE, OUR HOME</small></span></a><nav id="main-nav" aria-label="Main navigation"><c:forEach items="${config.navigation}" var="link"><a href="${pageContext.request.contextPath}${link.path}${empty link.fragment ? '' : '#'}${link.fragment}"><c:out value="${link.label}"/></a></c:forEach><a class="mobile-story" href="${pageContext.request.contextPath}/submit-blog">Share your story ↗</a></nav><div class="nav-actions"><app-theme-switcher><div class="theme-control"><button class="icon-button theme-trigger" aria-label="Choose color theme" aria-expanded="false"><ui:icon name="sun"/></button><div class="theme-popover" hidden><p class="eyebrow">Make yourself at home</p><strong>Choose your atmosphere</strong><div class="theme-options"><c:forEach items="${themes}" var="theme"><button data-theme="${theme.id}" aria-pressed="false"><span style="background:${theme.swatch}"></span><c:out value="${theme.name}"/><ui:icon name="check"/></button></c:forEach></div></div></div></app-theme-switcher><a class="button button-small nav-story" href="${pageContext.request.contextPath}/submit-blog">Share your story <ui:icon name="arrow"/></a><button class="icon-button menu-toggle" aria-label="Toggle navigation" aria-controls="main-nav" aria-expanded="false"><ui:icon name="menu"/></button></div></div></header></app-navbar>