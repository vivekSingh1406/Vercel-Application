<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%@ include file="../layout/header.jspf" %>
<section class="container page admin-page"><header class="section-heading"><div><p class="eyebrow">Care for our shared space</p><h1>Content workspace</h1></div><button class="button button-primary" data-export-url="${pageContext.request.contextPath}/admin/export"><ui:icon name="share"/> Export content</button></header><div class="notice"><strong>Our shared content workspace.</strong><p>Changes are saved for the community. Review stories before publishing, and export your content to keep a backup.</p></div><p><a class="button button-primary" href="/admin/exam-center/students">Student Management</a> <a class="button" href="/admin/exam-center/results">Results Management</a></p><div class="admin-tabs" aria-label="Content sections"><button data-tab="blogs">blogs <span>${fn:length(blogs)}</span></button><button data-tab="messages">messages <span>${fn:length(messages)}</span></button><button data-tab="submissions">submissions <span>${fn:length(drafts)}</span></button></div>
<div data-panel="blogs"><div class="section-heading compact"><h2>Village stories</h2><button class="button button-outline" data-add="blog">+ Add story</button></div><div class="admin-items"><c:forEach items="${blogs}" var="item"><%@ include file="../fragments/admin-story.jspf" %></c:forEach><c:if test="${empty blogs}"><p class="empty-state">No stories yet. Add the first one.</p></c:if></div></div>
<div data-panel="messages" hidden><div class="section-heading compact"><div><h2>Community messages</h2><p>The newest 5 messages are kept. Adding another removes the oldest.</p></div><button class="button button-outline" data-add="message">+ Add message</button></div><div class="admin-items"><c:forEach items="${messages}" var="item"><article class="admin-item" data-item="message"><div><h3><c:out value="${item.authorOfMessage}"/></h3><p><c:out value="${item.message}"/></p><small data-date="${item.createdAt}" data-date-style="datetime"><c:out value="${item.mediumDateTime}"/></small></div><div class="admin-actions"><button class="button button-outline" data-edit="message">Edit</button><button class="button button-danger" data-delete="message">Delete</button></div><div hidden><input data-value="id" value="${fn:escapeXml(item.id)}"/><input data-value="version" value="${item.version}"/><textarea data-value="name"><c:out value="${item.authorOfMessage}"/></textarea><textarea data-value="message"><c:out value="${item.message}"/></textarea></div></article></c:forEach><c:if test="${empty messages}"><p class="empty-state">No messages yet.</p></c:if></div></div>
<div data-panel="submissions" hidden><div class="section-heading compact"><div><h2>Story drafts</h2><p>These drafts are waiting for review. Sending through WhatsApp is a separate step.</p></div></div><div class="admin-items"><c:forEach items="${drafts}" var="item"><c:set var="draftRow" value="${true}"/><%@ include file="../fragments/admin-story.jspf" %><c:set var="draftRow" value="${false}"/></c:forEach><c:if test="${empty drafts}"><div class="empty-state"><h3>A fresh page.</h3><p>No submissions yet.</p><a href="${pageContext.request.contextPath}/submit-blog" class="text-link">Prepare a story →</a></div></c:if></div></div><div class="notice"><strong>Website updates</strong><p>Send your changes to the administrator on WhatsApp. The administrator will review and publish them on the website.</p></div></section>
<template id="blog-editor"><form class="admin-form" action="${pageContext.request.contextPath}/admin/stories/save" method="post" data-form="admin" novalidate><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="id"/><input type="hidden" name="version"/><input type="hidden" name="sourceDraft"/><label for="admin-title">Title</label><input id="admin-title" name="title" data-label="Title" required minlength="5" maxlength="140"/><small class="field-error" data-error="title" role="alert" hidden></small><label for="admin-slug">Story URL slug</label><div class="input-action"><input pattern="[a-z0-9]+(?:-[a-z0-9]+)*" id="admin-slug" name="slug" data-label="Story URL slug" required maxlength="512"/><button type="button" class="button button-outline" data-generate>Generate</button></div><small class="field-error" data-error="slug" role="alert" hidden></small><label for="admin-author">Author</label><input id="admin-author" name="author" data-label="Author" required maxlength="80"/><small class="field-error" data-error="author" role="alert" hidden></small><label for="admin-excerpt">Short introduction</label><textarea id="admin-excerpt" name="excerpt" data-label="Short introduction" required maxlength="300" rows="2"></textarea><small class="field-error" data-error="excerpt" role="alert" hidden></small><label for="admin-content">Full story</label><textarea id="admin-content" name="content" data-label="Full story" required minlength="80" maxlength="6000" rows="9"></textarea><small class="field-error" data-error="content" role="alert" hidden></small><label for="admin-image">Image path or HTTPS URL (optional)</label><input id="admin-image" name="image" data-label="Image path or HTTPS URL (optional)" placeholder="/media/village-2.jpg"/><small class="field-error" data-error="image" role="alert" hidden></small><label for="admin-category">Category</label><input id="admin-category" name="category" data-label="Category" maxlength="255"/><small class="field-error" data-error="category" role="alert" hidden></small><p class="form-hint">Saving makes this story visible on the website.</p><button class="button button-primary" type="submit">Save story <ui:icon name="check"/></button></form></template><template id="message-editor"><form class="admin-form" action="${pageContext.request.contextPath}/admin/messages/save" method="post" data-form="admin" novalidate><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="id"/><input type="hidden" name="version"/><label for="admin-message-name">Name</label><input id="admin-message-name" name="name" data-label="Name" required maxlength="80"/><small class="field-error" data-error="name" role="alert" hidden></small><label for="admin-message">Message</label><textarea id="admin-message" name="message" data-label="Message" required minlength="5" maxlength="600" rows="5"></textarea><small class="field-error" data-error="message" role="alert" hidden></small><button type="submit" class="button button-primary">Save message</button></form></template>
<%@ include file="../layout/footer.jspf" %>