<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%@ include file="../layout/header.jspf" %>
<section class="container page submission-page"><header class="page-heading"><p class="eyebrow"><c:out value="${info.pages.submission.eyebrow}"/></p><h1><c:out value="${info.pages.submission.title}"/></h1><p><c:out value="${info.pages.submission.description}"/></p></header><div class="submission-layout"><aside class="submission-aside"><img src="/media/village-4.jpg" alt="The village pond under an open blue sky" width="864" height="1920"/><h2><c:out value="${info.pages.submission.asideTitle}"/></h2><ol><c:forEach items="${info.pages.submission.steps}" var="step" varStatus="loop"><li><span>0${loop.count}</span><div><strong><c:out value="${step.title}"/></strong><p><c:out value="${step.text}"/></p></div></li></c:forEach></ol></aside><div class="form-card"><h2>Submit your blog</h2><p class="form-intro">Your words matter. Start wherever your memory takes you.</p><form action="${pageContext.request.contextPath}/submit-blog" method="post" enctype="multipart/form-data" data-form="submission" novalidate><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><label for="blog-name">Your name <span>*</span></label><input id="blog-name" autocomplete="name" name="name" data-label="Your name" required maxlength="80" placeholder="Your name"/><small class="field-error" data-error="name" role="alert" hidden></small><label for="blog-title">Story title <span>*</span></label><input id="blog-title" name="title" data-label="Story title" required minlength="5" maxlength="140" placeholder="Give your memory a title"/><small class="field-error" data-error="title" role="alert" hidden></small><label for="blog-content">Your story <span>*</span></label><textarea id="blog-content" name="content" data-label="Your story" required minlength="80" maxlength="6000" placeholder="It all began…" rows="12"></textarea><small class="field-error" data-error="content" role="alert" hidden></small><small class="form-hint"><span data-counter="content">0</span> / 6000 characters · At least 80 characters</small><label for="blog-image">A photograph <small>(optional)</small></label><div class="upload-zone"><ui:icon name="image"/><input id="blog-image" name="photo" type="file" accept="image/jpeg,image/png,image/webp"/><small>JPG, PNG or WebP · Maximum 1.5 MB</small></div><small class="field-error" data-error="photo" role="alert" hidden></small><img class="upload-preview" hidden alt="Your selected photograph"/><p class="form-hint">Your draft is saved for review. WhatsApp does not attach the image automatically; attach your original photo when sending. Nothing is published automatically.</p><button class="button button-primary" type="submit">Prepare my story <ui:icon name="arrow"/></button></form><div class="success-panel" role="status" hidden><ui:icon name="check"/><div><strong data-success-title></strong><p data-success-description></p><a class="button button-primary" data-success-link target="_blank" rel="noopener noreferrer">Continue to WhatsApp ↗</a></div></div></div></div></section>
<%@ include file="../layout/footer.jspf" %>