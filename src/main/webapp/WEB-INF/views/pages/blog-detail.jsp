<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%@ include file="../layout/header.jspf" %>
<section class="container page article-page"><a href="${pageContext.request.contextPath}/blog" class="text-link"><ui:icon name="back"/> Back to the journal</a><c:choose><c:when test="${not empty story}"><header class="article-heading"><p class="eyebrow"><c:out value="${empty story.category ? 'Village story' : story.category}"/></p><h1><c:out value="${story.title}"/></h1><p class="article-excerpt"><c:out value="${story.excerpt}"/></p><div class="article-byline"><span class="avatar"><c:out value="${fn:substring(story.author,0,1)}"/></span><span><c:out value="${story.author}"/><small><span data-date="${story.createdAt}" data-date-style="long"><c:out value="${story.longDate}"/></span> · ${story.readingMinutes} min read</small></span></div></header><c:if test="${not empty story.image}"><img class="article-hero" src="${fn:escapeXml(story.image)}" alt="${fn:escapeXml(story.title)}" width="1200" height="650"/></c:if><div class="article-body"><c:forEach items="${story.paragraphs}" var="paragraph"><p><c:out value="${paragraph}"/></p></c:forEach><div class="article-share"><strong>A story is better shared.</strong><button class="button button-outline" data-share="${fn:escapeXml(story.title)}"><ui:icon name="share"/> Share story</button><a class="button button-primary" href="${fn:escapeXml(shareUrl)}" target="_blank" rel="noopener noreferrer"><ui:icon name="chat"/> WhatsApp</a></div><div class="story-invitation"><p>Your memories belong here, too.</p><a href="${pageContext.request.contextPath}/submit-blog" class="text-link">Share your story →</a></div></div></c:when><c:otherwise><div class="empty-state"><h1>This story hasn’t been written yet.</h1><p>The link may have changed, or the story is no longer available.</p><a href="${pageContext.request.contextPath}/blog" class="button button-primary">Browse village stories</a></div></c:otherwise></c:choose></section>
<%@ include file="../layout/footer.jspf" %>