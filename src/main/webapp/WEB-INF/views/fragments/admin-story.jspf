<%@ page pageEncoding="UTF-8" %>
<article class="admin-item" data-item="${draftRow ? 'draft' : 'blog'}"><c:if test="${not draftRow}"><img src="${fn:escapeXml(empty item.image ? '/media/village-2.jpg' : item.image)}" alt="${fn:escapeXml(item.title)}" width="100" height="80"/></c:if><div><h3><c:out value="${item.title}"/></h3><p><c:out value="${item.author}"/> · <span data-date="${item.createdAt}"><c:out value="${item.date}"/></span></p><c:choose><c:when test="${draftRow}"><p><c:out value="${item.excerpt}"/></p><c:if test="${not empty item.imageName}"><small>Photo: <c:out value="${item.imageName}"/></small></c:if></c:when><c:otherwise><a href="${pageContext.request.contextPath}/blog/${fn:escapeXml(item.slug)}">Preview story ↗</a></c:otherwise></c:choose></div><div class="admin-actions"><button class="button button-outline" data-edit="${draftRow ? 'draft' : 'blog'}">${draftRow ? 'Review &amp; edit' : 'Edit'}</button><button class="button button-danger" data-delete="${draftRow ? 'draft' : 'blog'}">Delete</button></div><div hidden><c:forEach items="${['id','version','title','slug','author','excerpt','content','image','category']}" var="key"><textarea data-value="${key}"><c:out value="${item[key]}"/></textarea></c:forEach></div></article>