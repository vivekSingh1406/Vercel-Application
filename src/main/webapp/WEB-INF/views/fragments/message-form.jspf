<%@ page pageEncoding="UTF-8" %>
<app-message-form><div class="message-form-panel"><div><p class="eyebrow">Leave a little love</p><h3>Your voice belongs here.</h3><p>Share a memory, send your wishes, or simply say hello.</p></div><form action="${pageContext.request.contextPath}/messages" method="post" data-form="message" novalidate><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><label for="message-name">Your name</label><input id="message-name" name="name" autocomplete="name" data-label="Your name" required maxlength="80" placeholder="How should we call you?"/><small class="field-error" data-error="name" role="alert" hidden></small><label for="community-message">Your message</label><textarea id="community-message" name="message" data-label="Your message" required minlength="5" maxlength="600" placeholder="A few words from the heart…" rows="4"></textarea><small class="field-error" data-error="message" role="alert" hidden></small><small class="form-hint"><span data-counter="message">0</span> / 600 · Saved for our community. Use WhatsApp to share with the administrator.</small><button class="button button-primary" type="submit">Prepare your message <ui:icon name="arrow"/></button></form><div class="success-panel" role="status" hidden><ui:icon name="check"/><div><strong data-success-title></strong><p data-success-description></p><a class="button button-primary" data-success-link target="_blank" rel="noopener noreferrer">Continue to WhatsApp ↗</a></div></div></div></app-message-form>